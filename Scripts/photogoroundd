#!/bin/bash
#
# Builds the agent if needed and runs it, passing everything through.
#
# This is how the server gets staged: a long-scrollback screen session, this
# script, and then leaving it alone for a day.
#
#     screen -h 10000
#     cd photo-go-round
#     ./Scripts/photogoroundd
#
# It exists so that staging is one command rather than a remembered incantation
# about bin paths, and so the build never silently runs a stale binary.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIGURATION="${PGR_CONFIGURATION:-debug}"

# **Nothing generated goes in the repository.** Syd, 2026-09-19: "I really don't
# want build artifacts in the repo directory", and "I would prefer ALL generated
# artifacts to be in DerivedData and not .build directories". SwiftPM writes to
# `<package>/.build` unless told otherwise, so it is told otherwise.
SCRATCH="${PGR_BUILD_ROOT:-$HOME/Library/Developer/Xcode/DerivedData/Photo-Go-Round-scripts}/swiftpm"

if [[ "${1:-}" == "--release" ]]; then
    CONFIGURATION="release"
    shift
fi

# Build to stderr so stdout stays clean for the agent's own output — which
# matters when this is piped to a file or read back through a screen scrollback.
swift build --configuration "$CONFIGURATION" --package-path "$REPO" --scratch-path "$SCRATCH" >&2

BIN="$(swift build --configuration "$CONFIGURATION" --package-path "$REPO" --scratch-path "$SCRATCH" --show-bin-path)/photogoroundd"

# Nothing is exported here on purpose. The binary already defaults to its own
# development container and cache, and reaching the real library takes --prod. Setting
# it from the wrapper would mean the safety lived in the script rather than in
# the program, and would evaporate the moment somebody ran the binary directly.

# exec, so signals reach the agent rather than this script: ^C in screen should
# stop the server, not orphan it.
exec "$BIN" "$@"
